{
  "manifest_version": 3,
  "name": "OK.ru Music Downloader Pro",
  "version": "3.0.0",
  "description": "OK.ru üzerindeki müzikleri tekli veya toplu (playlist) olarak orijinal isimleriyle MP3 formatında indirin.",
  "author": "Lazz Sergen",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "*://*.okcdn.ru/*",
    "*://*.ok.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ok.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OK.ru Music Downloader Pro"
  }
}